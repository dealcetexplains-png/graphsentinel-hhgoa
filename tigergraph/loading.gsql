USE GRAPH GraphSentinel

CREATE LOADING JOB load_hhgoa FOR GRAPH GraphSentinel {
  DEFINE FILENAME f_customers;
  DEFINE FILENAME f_cards;
  DEFINE FILENAME f_transactions;
  DEFINE FILENAME f_devices;
  DEFINE FILENAME f_emails;
  DEFINE FILENAME f_regions;
  DEFINE FILENAME f_owns;
  DEFINE FILENAME f_made;
  DEFINE FILENAME f_from_device;
  DEFINE FILENAME f_purchaser_email;
  DEFINE FILENAME f_recipient_email;
  DEFINE FILENAME f_billed_in;
  DEFINE FILENAME f_next;
  DEFINE FILENAME f_closed_cases;
  DEFINE FILENAME f_closed_involves;
  DEFINE FILENAME f_closed_cards;

  LOAD f_customers TO VERTEX Customer VALUES ($0, $1, $2, $3) USING HEADER="true", SEPARATOR=",", QUOTE="double";
  LOAD f_cards TO VERTEX Card VALUES ($0, $1, $2, $3, $4, $5) USING HEADER="true", SEPARATOR=",", QUOTE="double";
  LOAD f_transactions TO VERTEX Transaction VALUES ($0, $1, $2, $3, $4, $5, $6, $7) USING HEADER="true", SEPARATOR=",", QUOTE="double";
  LOAD f_devices TO VERTEX DeviceProfile VALUES ($0, $1, $2, $3, $4, $5) USING HEADER="true", SEPARATOR=",", QUOTE="double";
  LOAD f_emails TO VERTEX EmailDomain VALUES ($0) USING HEADER="true", SEPARATOR=",", QUOTE="double";
  LOAD f_regions TO VERTEX BillingRegion VALUES ($0, $1) USING HEADER="true", SEPARATOR=",", QUOTE="double";
  LOAD f_closed_cases TO VERTEX ClosedCase VALUES ($0, $1, $2, $3, $4, $5, $6, $7) USING HEADER="true", SEPARATOR=",", QUOTE="double";

  LOAD f_owns TO EDGE OWNS VALUES ($0, $1) USING HEADER="true", SEPARATOR=",", QUOTE="double", VERTEX_MUST_EXIST="true";
  LOAD f_made TO EDGE MADE VALUES ($0, $1) USING HEADER="true", SEPARATOR=",", QUOTE="double", VERTEX_MUST_EXIST="true";
  LOAD f_from_device TO EDGE FROM_DEVICE VALUES ($0, $1, $2, $3) USING HEADER="true", SEPARATOR=",", QUOTE="double", VERTEX_MUST_EXIST="true";
  LOAD f_purchaser_email TO EDGE PURCHASER_EMAIL VALUES ($0, $1) USING HEADER="true", SEPARATOR=",", QUOTE="double", VERTEX_MUST_EXIST="true";
  LOAD f_recipient_email TO EDGE RECIPIENT_EMAIL VALUES ($0, $1) USING HEADER="true", SEPARATOR=",", QUOTE="double", VERTEX_MUST_EXIST="true";
  LOAD f_billed_in TO EDGE BILLED_IN VALUES ($0, $1) USING HEADER="true", SEPARATOR=",", QUOTE="double", VERTEX_MUST_EXIST="true";
  LOAD f_next TO EDGE NEXT VALUES ($0, $1, $2) USING HEADER="true", SEPARATOR=",", QUOTE="double", VERTEX_MUST_EXIST="true";
  LOAD f_closed_involves TO EDGE INVOLVES VALUES ($0 ClosedCase, $1 Transaction) USING HEADER="true", SEPARATOR=",", QUOTE="double", VERTEX_MUST_EXIST="true";
  LOAD f_closed_cards TO EDGE ON_CARD VALUES ($0 ClosedCase, $1 Card) USING HEADER="true", SEPARATOR=",", QUOTE="double", VERTEX_MUST_EXIST="true";
  LOAD f_closed_cards TO EDGE CONNECTED_TO VALUES ($0 ClosedCase, $1 Card, $2) WHERE $2 == "connected_card" USING HEADER="true", SEPARATOR=",", QUOTE="double", VERTEX_MUST_EXIST="true";
}
