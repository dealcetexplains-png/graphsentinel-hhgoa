// HHGOA / IEEE-CIS fraud-investigation graph.
// Attribute names follow docs/README.md and the graph-ready index in data/hhgoa/index.json.

CREATE VERTEX Customer(
  PRIMARY_ID id STRING,
  transaction_count UINT,
  first_seen DATETIME,
  last_seen DATETIME
) WITH primary_id_as_attribute="true";

CREATE VERTEX Card(
  PRIMARY_ID id STRING,
  fingerprint STRING,
  product_codes STRING,
  transaction_count UINT,
  first_seen DATETIME,
  last_seen DATETIME
) WITH primary_id_as_attribute="true";

CREATE VERTEX Transaction(
  PRIMARY_ID id STRING,
  ts DATETIME,
  amount DOUBLE,
  product_code STRING,
  channel STRING,
  risk_score DOUBLE,
  billing_country STRING,
  model_signals STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX DeviceProfile(
  PRIMARY_ID id STRING,
  profile STRING,
  device_info STRING,
  operating_system STRING,
  browser STRING,
  screen STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX EmailDomain(
  PRIMARY_ID id STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX BillingRegion(
  PRIMARY_ID id STRING,
  country STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX ClosedCase(
  PRIMARY_ID id STRING,
  opened_at DATETIME,
  closed_at DATETIME,
  outcome STRING,
  pattern STRING,
  exposure_usd DOUBLE,
  report_filed BOOL,
  analyst_notes STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX InvestigationCase(
  PRIMARY_ID id STRING,
  status STRING,
  verdict STRING,
  fraud_probability DOUBLE,
  pattern STRING,
  pattern_description STRING,
  exposure_usd DOUBLE,
  summary STRING,
  created_at DATETIME
) WITH primary_id_as_attribute="true";

CREATE DIRECTED EDGE OWNS(FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY";
CREATE DIRECTED EDGE MADE(FROM Card, TO Transaction) WITH REVERSE_EDGE="ON_SOURCE_CARD";
CREATE DIRECTED EDGE FROM_DEVICE(
  FROM Transaction,
  TO DeviceProfile,
  device_status STRING,
  proxy_flag STRING
) WITH REVERSE_EDGE="USED_BY_TRANSACTION";
CREATE DIRECTED EDGE PURCHASER_EMAIL(FROM Transaction, TO EmailDomain);
CREATE DIRECTED EDGE RECIPIENT_EMAIL(FROM Transaction, TO EmailDomain);
CREATE DIRECTED EDGE BILLED_IN(FROM Transaction, TO BillingRegion);
CREATE DIRECTED EDGE NEXT(FROM Transaction, TO Transaction, elapsed_seconds UINT);
CREATE DIRECTED EDGE INVOLVES(FROM ClosedCase|InvestigationCase, TO Transaction);
CREATE DIRECTED EDGE ON_CARD(FROM ClosedCase|InvestigationCase, TO Card);
CREATE DIRECTED EDGE CONNECTED_TO(FROM ClosedCase|InvestigationCase, TO Card, reason STRING);
CREATE DIRECTED EDGE SIMILAR_TO(
  FROM ClosedCase|InvestigationCase,
  TO ClosedCase,
  score DOUBLE,
  shared_indicators STRING
);

CREATE GRAPH FraudGraph(*);
