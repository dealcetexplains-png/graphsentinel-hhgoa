// Upgrade the empty GraphSentinel graph created in Savanna's visual designer.
// This keeps the existing Customer, Card, Transaction, Device, and
// InvestigationCase types and adds the HHGOA attributes and relationships.

USE GRAPH GraphSentinel

CREATE SCHEMA_CHANGE JOB graphsentinel_hhgoa_v1 FOR GRAPH GraphSentinel {
  ALTER VERTEX Customer ADD ATTRIBUTE (
    transaction_count UINT,
    first_seen DATETIME,
    last_seen DATETIME
  );

  ALTER VERTEX Card ADD ATTRIBUTE (
    fingerprint STRING,
    product_codes STRING,
    transaction_count UINT,
    first_seen DATETIME,
    last_seen DATETIME
  );

  ALTER VERTEX Transaction ADD ATTRIBUTE (
    ts DATETIME,
    amount DOUBLE,
    product_code STRING,
    channel STRING,
    risk_score DOUBLE,
    billing_country STRING,
    model_signals STRING
  );

  ALTER VERTEX InvestigationCase ADD ATTRIBUTE (
    status STRING,
    verdict STRING,
    fraud_probability DOUBLE,
    pattern STRING,
    pattern_description STRING,
    exposure_usd DOUBLE,
    summary STRING,
    created_at DATETIME
  );

  ADD VERTEX DeviceProfile(
    PRIMARY_ID id STRING,
    profile STRING,
    device_info STRING,
    operating_system STRING,
    browser STRING,
    screen STRING
  ) WITH primary_id_as_attribute="true";

  ADD VERTEX EmailDomain(
    PRIMARY_ID id STRING
  ) WITH primary_id_as_attribute="true";

  ADD VERTEX BillingRegion(
    PRIMARY_ID id STRING,
    country STRING
  ) WITH primary_id_as_attribute="true";

  ADD VERTEX ClosedCase(
    PRIMARY_ID id STRING,
    opened_at DATETIME,
    closed_at DATETIME,
    outcome STRING,
    pattern STRING,
    exposure_usd DOUBLE,
    report_filed BOOL,
    analyst_notes STRING
  ) WITH primary_id_as_attribute="true";

  ADD DIRECTED EDGE OWNS(FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY";
  ADD DIRECTED EDGE MADE(FROM Card, TO Transaction) WITH REVERSE_EDGE="ON_SOURCE_CARD";
  ADD DIRECTED EDGE FROM_DEVICE(
    FROM Transaction,
    TO DeviceProfile
  ) WITH REVERSE_EDGE="USED_BY_TRANSACTION";
  ADD DIRECTED EDGE PURCHASER_EMAIL(FROM Transaction, TO EmailDomain);
  ADD DIRECTED EDGE RECIPIENT_EMAIL(FROM Transaction, TO EmailDomain);
  ADD DIRECTED EDGE BILLED_IN(FROM Transaction, TO BillingRegion);
  ADD DIRECTED EDGE NEXT(FROM Transaction, TO Transaction);
  ADD DIRECTED EDGE INVOLVES(
    FROM ClosedCase, TO Transaction |
    FROM InvestigationCase, TO Transaction
  );
  ADD DIRECTED EDGE ON_CARD(
    FROM ClosedCase, TO Card |
    FROM InvestigationCase, TO Card
  );
  ADD DIRECTED EDGE CONNECTED_TO(
    FROM ClosedCase, TO Card |
    FROM InvestigationCase, TO Card
  );
  ADD DIRECTED EDGE SIMILAR_TO(
    FROM ClosedCase, TO ClosedCase |
    FROM InvestigationCase, TO ClosedCase
  );

}

RUN SCHEMA_CHANGE JOB graphsentinel_hhgoa_v1
DROP JOB graphsentinel_hhgoa_v1

CREATE SCHEMA_CHANGE JOB graphsentinel_hhgoa_edge_attrs_v1 FOR GRAPH GraphSentinel {
  ALTER EDGE FROM_DEVICE ADD ATTRIBUTE (device_status STRING);
  ALTER EDGE FROM_DEVICE ADD ATTRIBUTE (proxy_flag STRING);
  ALTER EDGE NEXT ADD ATTRIBUTE (elapsed_seconds UINT);
  ALTER EDGE CONNECTED_TO ADD ATTRIBUTE (reason STRING);
  ALTER EDGE SIMILAR_TO ADD ATTRIBUTE (score DOUBLE);
  ALTER EDGE SIMILAR_TO ADD ATTRIBUTE (shared_indicators STRING);
}

RUN SCHEMA_CHANGE JOB graphsentinel_hhgoa_edge_attrs_v1
DROP JOB graphsentinel_hhgoa_edge_attrs_v1
