PORT=8787

# Leave DEMO_MODE=true until a TigerGraph graph is available.
DEMO_MODE=true
TIGERGRAPH_HOST=https://your-instance.i.tgcloud.io
TIGERGRAPH_GRAPH=FraudGraph
TIGERGRAPH_TOKEN=replace-me
TIGERGRAPH_CONTEXT_QUERY=fraud_case_context

# Advisory LLM ensemble. Never commit real credentials.
# Gemini supports GEMINI_API_KEY_1 through GEMINI_API_KEY_16 as a failover pool.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
SPIRIT_OPENROUTER_MODEL=openrouter/openai/gpt-4.1-mini
MISTRAL_API_KEY=
SPIRIT_MISTRAL_MODEL=mistral-small-latest
SPIRIT_MISTRAL_AGENT_ID=
SPIRIT_MISTRAL_AGENT_VERSION=

# Optional local Spirit OpenAI-compatible gateway.
SPIRIT_AGENT_HOST=127.0.0.1
SPIRIT_AGENT_PORT=8011
SPIRIT_AGENT_MODEL=auto
# SPIRIT_AGENT_URL=http://127.0.0.1:8011/v1/chat/completions
LLM_TIMEOUT_MS=20000

# Required when AUTH_REQUIRED=true or NODE_ENV=production.
AUTH_REQUIRED=false
APP_USERNAME=analyst
APP_SESSION_SECRET=
APP_PASSWORD_HASH=
APP_ORIGIN=https://your-public-app.example
# Production ignores local env files by default; prefer a platform secret manager.
# ALLOW_ENV_FILES=false

# Live graph writeback and optional integration test.
TIGERGRAPH_WRITEBACK=true
TIGERGRAPH_TIMEOUT_MS=10000
TIGERGRAPH_LIVE_TEST=false
TIGERGRAPH_TEST_TRANSACTION_ID=3514030
